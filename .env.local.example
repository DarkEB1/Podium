# =============================================================================
# Podium — local environment
#
# Copy to `.env.local` and fill in. Every variable below is validated by
# lib/env.ts on first use; a missing or malformed value fails fast with one
# aggregated error listing everything that is wrong.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put a secret
# behind a NEXT_PUBLIC_ prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

# Supabase Dashboard → Project Settings → API → Project URL
# Local dev with `supabase start`: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Dashboard → Project Settings → API → Project API keys → anon / public
# Safe to expose; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Dashboard → Project Settings → API → Project API keys → service_role
# SERVER ONLY. Bypasses RLS. Used by createAdminClient() in route handlers and
# by the Stripe webhook. Never import into a "use client" module.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------

# Stripe Dashboard → Developers → API keys → Secret key
# Use the test-mode key (sk_test_…) locally. A restricted key (rk_…) is accepted.
STRIPE_SECRET_KEY=sk_test_...

# Stripe Dashboard → Developers → API keys → Publishable key
# Optional today; required once Stripe Elements / Checkout.js runs client-side.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Signing secret for POST /api/webhooks/stripe.
# Local: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#        and copy the whsec_… it prints.
# Deployed: Stripe Dashboard → Developers → Webhooks → your endpoint →
#           Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Recurring Price IDs for the three brand subscription tiers.
# Stripe Dashboard → Product catalogue → <product> → Pricing → API ID (price_…).
# Set `metadata.tier` = 1 | 2 | 3 on each Price — the webhook reads it to fill
# subscriptions.tier.
#   Tier 1 = Starter, Tier 2 = Growth, Tier 3 = Enterprise
STRIPE_PRICE_TIER_1=price_...
STRIPE_PRICE_TIER_2=price_...
STRIPE_PRICE_TIER_3=price_...

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Public origin of this deployment. Used to build Stripe checkout success/cancel
# URLs and Supabase auth redirect URLs, so it must match the browser origin
# exactly (scheme + host + port, no trailing slash).
# NEXT_PUBLIC_SITE_URL is accepted as an alias if you prefer that name.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# E-Signature (DocuSign or HelloSign — add when integrating)
# -----------------------------------------------------------------------------
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Scheduled jobs (Vercel Cron)
# -----------------------------------------------------------------------------

# Shared secret for the cron entry points (/api/cron/*). Vercel Cron sends this
# as `Authorization: Bearer <CRON_SECRET>` when it is set as a project env var.
# The routes FAIL CLOSED: if this is unset, every cron request is rejected 401
# and the GDPR erasure job silently never runs. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# Observability (optional — DH-6)
# -----------------------------------------------------------------------------

# lib/observability always writes structured JSON to stdout, which Vercel
# ingests and makes queryable — that path needs no configuration and no
# dependency.
#
# Set a DSN ONLY if you also `npm install @sentry/node`; the SDK is then loaded
# lazily at runtime and every capture is forwarded to Sentry as well. Leave
# blank to stay on stdout-only logging.
# Sentry → Project Settings → Client Keys (DSN)
# SENTRY_DSN=

# -----------------------------------------------------------------------------
# Transactional email (lib/email — Resend)
# -----------------------------------------------------------------------------

# Resend API key (starts "re_"). Resend → API Keys.
# When UNSET, the email layer is a no-op: it records every send as "skipped" in
# email_deliveries and delivers nothing. Local dev and CI need no mail account.
RESEND_API_KEY=

# Envelope From. Must be a domain you have verified in Resend.
# e.g. "Podium <notifications@mail.podium.app>"
EMAIL_FROM=

# Optional Reply-To for transactional mail.
EMAIL_REPLY_TO=

# HMAC key for one-click unsubscribe links (CL-4). Min 16 chars.
# Generate with: openssl rand -hex 32
# When unset, marketing emails carry a preferences link instead of a one-click
# unsubscribe, and the unsubscribe route rejects every token (fails closed).
UNSUBSCRIBE_SECRET=

# -----------------------------------------------------------------------------
# Admin two-factor authentication (2.4)
# -----------------------------------------------------------------------------
# AES-256-GCM key that seals TOTP secrets at rest (auth_2fa.secret). Exactly
# 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
# When unset, admin 2FA enrollment fails closed (cannot store a secret).
TWO_FACTOR_ENCRYPTION_KEY=

# HMAC key signing the "admin passed 2FA this session" cookie. Min 16 chars.
# Generate with: openssl rand -hex 32
# When unset, the cookie cannot be minted or verified, so admins are locked out
# of /admin until it is set (fails closed).
ADMIN_2FA_COOKIE_SECRET=
